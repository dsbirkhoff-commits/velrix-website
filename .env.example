# Kopieer dit bestand naar .env.local voor lokale ontwikkeling.
# In Vercel zet je deze als Environment Variables (Settings -> Environment Variables).

# --- Klantportaal (Supabase) ---
# VITE_-variabelen komen in de browser-bundel terecht — dat is met opzet,
# want de "anon key" is veilig om te delen (Row Level Security regelt de
# daadwerkelijke beveiliging, niet deze key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — NOOIT met VITE_ prefixen, anders komt hij alsnog in
# de browser-bundel terecht. Alleen gebruikt in api/_supabase.js.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Het organizations.id van de VELRIX-organisatie (zie supabase/seed.sql) —
# gebruikt om publieke boekingen best-effort te synchroniseren naar het
# dashboard.
VELRIX_SEED_ORGANIZATION_ID=

# --- Bestaande Google Calendar-koppeling (ongewijzigd) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Amsterdam
ADMIN_SETUP_SECRET=
